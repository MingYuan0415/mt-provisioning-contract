{
  "schema": 1,
  "transport": "ble",
  "security": 2,
  "bootstrap_requests": [
    "get_capabilities"
  ],
  "steady_request": "get_snapshot",
  "interval_ms": 2000,
  "maximum_idle_ms": 10000,
  "maximum_in_flight": 1,
  "request_id": {
    "nonzero": true,
    "unique_per_session": true,
    "retry_reuses_id": false
  },
  "forbidden_steady_requests": [
    "get_capabilities",
    "get_operation",
    "start_scan",
    "get_scan_results",
    "set_credentials",
    "cancel_operation",
    "disconnect",
    "reconnect_saved",
    "forget_saved",
    "set_auto_connect",
    "subscribe_events",
    "finish_session"
  ],
  "steady_disconnects": 0,
  "steady_reconnects": 0,
  "blind_retry": false
}
