[
  {"id": "missing-pop", "remove": ["pop"]},
  {"id": "lowercase-device-id", "replace": {"device_id": "a1b2c3"}},
  {"id": "short-device-id", "replace": {"device_id": "A1B2C"}},
  {"id": "name-mismatch", "replace": {"name": "MT-FFFFFF"}},
  {"id": "wrong-security", "replace": {"security": 1}},
  {"id": "string-security", "replace": {"security": "2"}},
  {"id": "padded-pop", "replace": {"pop": "AAECAwQFBgcICQoLDA0ODw=="}},
  {"id": "short-pop", "replace": {"pop": "AAECAwQFBgcICQoLDA0OD"}},
  {"id": "invalid-pop-character", "replace": {"pop": "AAECAwQFBgcICQoLDA0OD!"}},
  {"id": "wrong-service", "replace": {"service": "00000000-0000-0000-0000-000000000000"}},
  {"id": "wrong-transport-type", "replace": {"transport": true}},
  {"id": "array-root", "payload": []}
]
